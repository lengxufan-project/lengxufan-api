<!DOCTYPE html>
<html lang="zh">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>冷旭帆 · 世界入口</title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <div id="intro-overlay"><div class="intro-bg"></div><div class="intro-sphere"></div></div>

    <div class="world-container fade-in">
        <header class="world-header">
            <h1>冷旭帆 <span style="font-weight:300;">· 世界入口</span></h1>
            <div class="header-actions" id="header-actions">
                <button id="btn-login" onclick="openLoginModal()">登录 / 游客</button>
                <span id="user-display" style="display:none; font-size:13px; color:#8b949e;"></span>
                <button id="btn-logout" style="display:none;" onclick="logout()">退出</button>
            </div>
            <div class="status-badge">307室 · 潜龙学院</div>
        </header>

        <div class="scene-area" id="scene-area">
            <div class="bg-layer" id="bg-layer" style="background-image:url('/assets/backgrounds/snow-palace.webp')"></div>
            <div class="overlay"></div>
            <div class="scene-content">
                <div class="scene-info" id="scene-info">🌃 307室 · 深夜</div>
                <div class="room-activity" id="room-activity">室友们正在……</div>
                <div class="character-display">
                    <div class="char-item" onclick="switchChar('lengxufan')">
                        <div class="sprite" id="sprite-lengxufan"><img src="/assets/characters/A.png" alt="冷旭帆"></div>
                        <div class="label">冷旭帆</div>
                        <div class="emotion-badge" id="lxf-emotion">😐 平静</div>
                    </div>
                    <div class="char-item" onclick="switchChar('huangjingyun')">
                        <div class="sprite" id="sprite-huangjingyun"><img src="/assets/characters/B.png" alt="黄景云"></div>
                        <div class="label">黄景云</div>
                        <div class="emotion-badge" id="hyj-emotion">🙂 稍好</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="chat-area">
            <div class="chat-messages" id="chat-messages"></div>
            <div class="chat-input-group">
                <input type="text" id="chat-input" placeholder="说点什么..." />
                <button id="chat-send">发送</button>
            </div>
        </div>

        <div class="status-bar" id="status-bar">
            <span class="item">情绪 <span class="value" id="emotion-value">--</span></span>
            <span class="item">身体 <span class="value" id="body-value">--</span></span>
            <span class="item">心理 <span class="value" id="mind-value">--</span></span>
            <span class="item">关系 <span class="value" id="relation-value">--</span></span>
            <span class="item">天气 <span class="value" id="weather-value">--</span></span>
            <span class="item">时间 <span class="value" id="time-value">--</span></span>
            <span class="item">世界日 <span class="value" id="day-value">--</span></span>
            <span class="item"><span class="dot green"></span> 在线</span>
        </div>

        <div class="curve-container">
            <canvas id="emotion-curve" width="960" height="80"></canvas>
        </div>

        <div class="footer-actions" id="footer-actions">
            <button class="active" id="btn-lengxufan">冷旭帆</button>
            <button id="btn-huangjingyun">黄景云</button>
            <button id="btn-switch-bg" onclick="cycleBackground()">切换场景</button>
            <button id="btn-dev" onclick="openDevPanel()" style="display:none;">开发者</button>
            <button id="btn-profile" onclick="openProfileModal()">个人中心</button>
            <button id="btn-export" onclick="exportConversation()">导出</button>
            <span class="spacer"></span>
            <span style="color:#484f58;font-size:12px;">v5.5 · 占位符</span>
        </div>
    </div>

    <!-- 登录弹窗 -->
    <div class="modal" id="login-modal">
        <div class="modal-content">
            <div class="modal-title">进入世界</div>
            <div class="form-group"><input type="text" id="login-username" placeholder="用户名"></div>
            <div class="form-group"><input type="password" id="login-password" placeholder="密码"></div>
            <div class="modal-actions">
                <button class="btn-primary" onclick="login()">登录</button>
                <button class="btn-secondary" onclick="register()">注册</button>
                <button class="btn-secondary" onclick="guestLogin()">游客进入</button>
            </div>
        </div>
    </div>

    <!-- 开发者面板 -->
    <div class="dev-modal" id="dev-modal">
        <div class="dev-content">
            <button class="dev-close" onclick="closeDevPanel()">&times;</button>
            <div class="dev-title">开发者面板</div>
            <div id="dev-panel-content">
                <div class="dev-section"><h4>情绪</h4><div class="dev-value" id="dev-emotion">--</div></div>
                <div class="dev-section"><h4>身体</h4><div class="dev-value" id="dev-body">--</div></div>
                <div class="dev-section"><h4>心理</h4><div class="dev-value" id="dev-mind">--</div></div>
                <div class="dev-section"><h4>关系</h4><div class="dev-value" id="dev-relation">--</div></div>
                <div class="dev-section"><h4>望仔验证</h4><div class="dev-value" id="dev-wang">未触发</div></div>
                <div class="dev-section"><h4>思考链</h4><div class="dev-value" id="dev-thought">--</div></div>
                <div class="dev-section"><h4>最近事件</h4><div class="dev-value" id="dev-events">--</div></div>
                <div class="dev-section"><h4>室友活动</h4><div class="dev-value" id="dev-dorm">--</div></div>
                <div class="dev-section"><h4>最后里程碑</h4><div class="dev-value" id="dev-milestone">--</div></div>
            </div>
        </div>
    </div>

    <script src="/js/app.js"></script>
<div class="profile-modal" id="profile-modal">
    <div class="profile-content">
        <button class="profile-close" onclick="closeProfileModal()">&times;</button>
        <div class="profile-title">个人中心 · 回忆碎片</div>
        <div class="profile-info" id="profile-info">未登录</div>
        <div id="memory-list"></div>
    </div>
</div>
</body>
</html>